[sub_resource type="Resource" id="Outcome_walk_away_0"]
script = ExtResource("3_outcome")
probability = 1.0
effects = Array[ExtResource("4_effect")]([SubResource("Effect_walk_away_0_0")])
result_text = "You step around the puddle. The pink paw keeps dripping without you."

[sub_resource type="Resource" id="Choice_walk_away"]
script = ExtResource("2_choice")
id = &"walk_away"
label = "Walk away"
is_safe = true
outcomes = Array[ExtResource("3_outcome")]([SubResource("Outcome_walk_away_0")])

[resource]
script = ExtResource("1_event")
id = &"e03_chalk_artist"
act = 1
title = "Chalk Artist"
text = "A chalk artist kneels by a puddle, sketching a neon-pink paw that drips without rain. \"Stencils, sweetheart,\" she says, tapping a jar. \"Thorny gives your moves a little spine. Pay up or bet up.\""
choices = Array[ExtResource("2_choice")]([SubResource("Choice_pay"), SubResource("Choice_bet"), SubResource("Choice_walk_away")])
