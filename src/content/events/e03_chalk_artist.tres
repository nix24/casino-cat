amount = -25

[sub_resource type="Resource" id="Effect_pay_0_1"]
script = ExtResource("4_effect")
kind = 7
id = &"thorny"

[sub_resource type="Resource" id="Outcome_pay_0"]
script = ExtResource("3_outcome")
probability = 1.0
effects = Array[ExtResource("4_effect")]([SubResource("Effect_pay_0_0"), SubResource("Effect_pay_0_1")])
result_text = "She chalks a spiked stencil onto your move. Thorny, as promised."

[sub_resource type="Resource" id="Choice_pay"]
script = ExtResource("2_choice")
id = &"pay"
label = "Pay 25 Purrls"
is_safe = true
min_purrls = 25
outcomes = Array[ExtResource("3_outcome")]([SubResource("Outcome_pay_0")])

[sub_resource type="Resource" id="Effect_bet_0_0"]
script = ExtResource("4_effect")
kind = 7
id = &"sharpened"

[sub_resource type="Resource" id="Outcome_bet_0"]
script = ExtResource("3_outcome")
probability = 0.6
effects = Array[ExtResource("4_effect")]([SubResource("Effect_bet_0_0")])
result_text = "She grins and sketches a keen edge onto your claws. Sharpened."

[sub_resource type="Resource" id="Effect_bet_1_0"]
script = ExtResource("4_effect")
kind = 1
amount = -6

[sub_resource type="Resource" id="Outcome_bet_1"]
script = ExtResource("3_outcome")
probability = 0.4
effects = Array[ExtResource("4_effect")]([SubResource("Effect_bet_1_0")])
result_text = "The chalk smears, and so does your fur. The stencil costs you 6 HP."

[sub_resource type="Resource" id="Choice_bet"]
script = ExtResource("2_choice")
id = &"bet"
label = "Bet 6 HP on a stencil"
is_safe = false
outcomes = Array[ExtResource("3_outcome")]([SubResource("Outcome_bet_0"), SubResource("Outcome_bet_1")])

[sub_resource type="Resource" id="Effect_walk_away_0_0"]
script = ExtResource("4_effect")
